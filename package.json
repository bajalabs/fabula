{
  "name": "fabula",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hostable document rendering service: templates plus data in, PDF, HTML and images out, through Typst, Pandoc, Quarto, WeasyPrint, MJML and Chromium.",
  "license": "MIT",
  "author": "Baja Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/bajalabs/fabula.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest --maxWorkers=2"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "csv-parse": "^5.6.0",
    "fastify": "^5.8.5",
    "mjml": "^5.4.1",
    "nestjs-cls": "^5.0.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/node": "^22.10.2",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.8"
  }
}
