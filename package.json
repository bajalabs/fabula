{
  "name": "fabula",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A self-hostable document rendering service: templates plus data in, PDF, HTML and images out, through Typst, Pandoc, Quarto, WeasyPrint, MJML and Chromium.",
  "license": "MIT",
  "author": "Baja Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/bajalabs/fabula.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=.env --watch-path=dist dist/main.js)",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest --maxWorkers=2"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-fastify": "^11.2.9",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.8",
    "mjml": "^5.4.1",
    "nestjs-cls": "^5.4.3",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^11.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
