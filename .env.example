# Fabula's configuration, every variable with its default. Copy to .env (compose and `pnpm start` read it) and fill
# in at least the keys of your auth mode. An empty value counts as unset.

# Server
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info

# Auth: hmac (signed requests, the default) or token (Authorization: Bearer)
FABULA_AUTH=hmac
# hmac: caller name → hex key, at least 32 hex characters each (openssl rand -hex 32)
FABULA_HMAC_KEYS='{"me":"replace-with-64-hex-characters"}'
# token: caller name → token, at least 32 printable characters each
FABULA_TOKENS=

# Brand files and document pictures: the hosts they may be fetched from (exact, or *.example.com; :port when not 443)
FABULA_ASSET_HOSTS=
# Callbacks: the key Fabula signs them with (64 hex characters) and the hosts they may go to (host or host:port)
FABULA_CALLBACK_KEY=
FABULA_CALLBACK_HOSTS=

# Limits
FABULA_BODY_LIMIT_BYTES=8388608
FABULA_MAX_CONCURRENT_RENDERS=6
FABULA_RENDER_TIMEOUT_SECONDS=60
FABULA_ASSET_MAX_BYTES=10485760
FABULA_ASSET_TIMEOUT_SECONDS=15
FABULA_IMAGE_MAX_PIXELS=40000000

# Storage (the defaults are under the system temp folder and ./templates)
FABULA_ASSET_CACHE_DIR=
FABULA_ASSET_CACHE_MAX_BYTES=536870912
FABULA_TEMPLATES_DIR=

# What runs
FABULA_ENGINES=typst,pandoc,quarto,weasyprint,mjml,chromium
FABULA_ALLOW_INLINE_SOURCE=true
FABULA_CHROMIUM_PATH=chromium
FABULA_REQUIRE_ENGINES=true
FABULA_DRAIN_SECONDS=30
