{
  "name": "social-card",
  "kind": "social",
  "version": 1,
  "title": "Social card",
  "description": "A 1200 × 630 card for a link preview, in HTML and CSS, rendered by headless Chromium to PNG (or JPEG). Scripts are off and the page can load only its own files.",
  "format": "html",
  "output": "png",
  "entry": "main.html",
  "fields": [
    {
      "key": "tag",
      "label": "Tag",
      "fieldTypeKey": "string",
      "defaultValue": "News",
      "sortOrder": 1
    },
    {
      "key": "title",
      "label": "Title",
      "fieldTypeKey": "string",
      "isRequired": true,
      "maxLength": 120,
      "defaultValue": "",
      "sortOrder": 2
    },
    {
      "key": "subtitle",
      "label": "Subtitle",
      "fieldTypeKey": "string",
      "maxLength": 200,
      "defaultValue": "",
      "sortOrder": 3
    },
    {
      "key": "site",
      "label": "Site",
      "fieldTypeKey": "string",
      "defaultValue": "",
      "sortOrder": 4
    }
  ],
  "engineConfig": {
    "viewport": {
      "width": 1200,
      "height": 630,
      "deviceScaleFactor": 1
    }
  },
  "sample": {
    "tag": "New",
    "title": "The spring menu is here",
    "subtitle": "Six seasonal loaves, baked twice a day",
    "site": "example.com"
  }
}
